[Unit]
Description=MVPT-4 Calculateur (gunicorn)
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
Environment="DB_PATH=__DATA_DIR__/mvpt4.db"
Environment="SECRET_KEY=__SECRET_KEY__"
ExecStart=__INSTALL_DIR__/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:__PORT__ \
    --timeout 60 \
    --access-logfile /var/log/__APP__/__APP__.log \
    --error-logfile /var/log/__APP__/__APP__-error.log \
    wsgi:app

Restart=on-failure
RestartSec=5s

# Sécurité
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__ /var/log/__APP__

[Install]
WantedBy=multi-user.target
