[Unit]
Description=MVPT-4 Calculateur
After=network.target

[Service]
Type=simple
User=__APP__
Group=www-data
WorkingDirectory=__INSTALL_DIR__
Environment="PATH=__INSTALL_DIR__/venv/bin:/usr/bin"
Environment="DB_PATH=__DATA_DIR__/mvpt4.db"
ExecStart=__INSTALL_DIR__/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:__PORT__ \
    --timeout 60 \
    --log-file /var/log/__APP__/__APP__.log \
    --access-logfile /var/log/__APP__/access.log \
    wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
